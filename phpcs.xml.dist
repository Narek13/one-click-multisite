<?xml version="1.0"?>
<ruleset name="One Click Multisite">
    <description>WordPress.org-aligned coding standards for One Click Multisite (modern PSR-4 / namespaced).</description>

    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- What to scan. -->
    <file>./one-click-multisite.php</file>
    <file>./src</file>
    <file>./templates</file>
    <file>./tests</file>
    <file>./uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/.ddev/*</exclude-pattern>

    <!--
        Base on the WordPress.org review standard, then drop only the sniffs
        that fight modern PSR-4 / namespaced OO code. All security, escaping,
        sanitisation and i18n rules (what the plugin review team checks) stay on.
    -->
    <rule ref="WordPress-Extra">
        <!-- PSR-4 file names (Foo.php) instead of class-foo.php. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Allow camelCase methods/properties (PSR style). -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
    </rule>

    <rule ref="WordPress-Docs">
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <!-- Allow PHPStan generic types (list<T>, array<K,V>) in @param/@return. -->
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
    </rule>

    <!-- PHP version compatibility (minimum supported version below). -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- i18n: enforce a single text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="one-click-multisite"/>
            </property>
        </properties>
    </rule>

    <!-- Require prefixing of global symbols. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="one_click_multisite"/>
                <element value="OneClickMultisite"/>
                <element value="ONE_CLICK_MULTISITE"/>
            </property>
        </properties>
    </rule>

    <!-- Minimum supported versions for compatibility checks. -->
    <config name="minimum_wp_version" value="6.4"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
