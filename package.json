{
    "name": "one-click-multisite",
    "version": "1.1.0",
    "private": true,
    "description": "Convert a single-site WordPress installation into a multisite network with one click.",
    "license": "GPL-2.0-or-later",
    "author": {
        "name": "Narek Zakarian"
    },
    "scripts": {
        "setup": "composer install",
        "phpcs": "composer phpcs",
        "phpcs:fix": "composer phpcs:fix",
        "phpstan": "composer phpstan",
        "tests": "composer phpunit",
        "lint": "npm run phpcs && npm run phpstan",
        "check": "composer test",
        "build": "bash bin/build-zip.sh"
    }
}
